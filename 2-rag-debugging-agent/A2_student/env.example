# env.example: copy this file to ".env" and UNCOMMENT exactly ONE key line. Never commit your real .env.
# The provided client loads .env automatically from the package root.
# Leave the other line commented so only one provider is active.

# Option A - TAMU AI Chat (free, rate-limited):
# TAMUS_AI_CHAT_API_KEY=your_tamu_key_here

# Option B - your own OpenAI key (paid):
# OPENAI_API_KEY=sk-...
