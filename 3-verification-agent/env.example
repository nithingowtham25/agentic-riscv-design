# env.example: copy this file to ".env" and set the key(s) you use. Never commit your real .env.
# Your agent reads its key from an environment variable; .env is loaded from the package root.
#
# Assignment 3 note: your agent MUST work with --provider tamu, so set
# TAMUS_AI_CHAT_API_KEY here. You may ALSO set another provider's key if you develop against it.

# TAMU AI Chat (required to work for Assignment 3):
# TAMUS_AI_CHAT_API_KEY=your_tamu_key_here

# Optional -- if you develop against another provider:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
